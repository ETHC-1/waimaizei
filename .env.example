# Self-hosted MongoDB connection details
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=replace-with-a-long-alphanumeric-password
MONGODB_URI=mongodb://admin:replace-with-a-long-alphanumeric-password@mongo:27017/takeaway_theft?authSource=admin

# Backend-only administrator credentials. Never put these in HTML or commit a real .env file.
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
